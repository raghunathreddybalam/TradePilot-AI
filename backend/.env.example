# Local default: SQLite (no Docker needed)
DATABASE_URL="file:./dev.db"

PORT=4000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV=development

TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false
PAPER_STARTING_EQUITY=50000

# Market data: mock | upstox | fivepaisa | angel | zerodha
MARKET_DATA_PROVIDER=mock

WATCHLIST="NIFTY 50,NIFTY BANK"

# ========== UPSTOX (FREE — recommended for you) ==========
# 1. Create app: https://account.upstox.com/developer/apps
# 2. Redirect URI must be exactly: http://127.0.0.1:4000/api/upstox/callback
# 3. Fill API key/secret below, restart, open http://localhost:4000/api/upstox/login
# 4. After login, paste access token here and set MARKET_DATA_PROVIDER=upstox
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:4000/api/upstox/callback
UPSTOX_ACCESS_TOKEN=

# ========== 5PAISA (FREE alternative) ==========
# Easiest: generate access token from https://xstream.5paisa.com/ then:
FIVEPAISA_ACCESS_TOKEN=
FIVEPAISA_CLIENT_CODE=
# Optional full login keys (if not using access token):
FIVEPAISA_APP_NAME=
FIVEPAISA_APP_SOURCE=
FIVEPAISA_USER_ID=
FIVEPAISA_PASSWORD=
FIVEPAISA_USER_KEY=
FIVEPAISA_ENCRYPTION_KEY=

# ========== ANGEL ONE (optional) ==========
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_FILTER_ENABLED=true

KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
