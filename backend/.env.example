# Local default: SQLite (no Docker needed)
DATABASE_URL="file:./dev.db"

# Production / Docker Postgres:
# 1. Change prisma/schema.prisma provider to "postgresql"
# 2. DATABASE_URL="postgresql://tradepilot:tradepilot@localhost:5432/tradepilot?schema=public"
# 3. docker compose up -d

PORT=4000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV=development

TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false
PAPER_STARTING_EQUITY=500000

USE_MOCK_MARKET_DATA=true
WATCHLIST="NIFTY 50,NIFTY BANK,RELIANCE,TCS,INFY,HDFCBANK"

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_FILTER_ENABLED=true

KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
